rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    // 1. PORTFÓLIO — mídia destinada ao site público
    match /users/{userId}/portfolio/{portfolioId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // 2. CATEGORIAS — capas destinadas ao site público
    match /users/{userId}/categories/{categoryId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // 3. ORÇAMENTOS — arquivos privados
    match /users/{userId}/quotes/{quoteId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // 4. ORDENS DE SERVIÇO — fotos/evidências privadas
    match /users/{userId}/service-orders/{orderId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // 5. Qualquer outro caminho fica bloqueado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
