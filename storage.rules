rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all uploaded images (portfolio, OS evidence, quotes, category covers)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Write allowed only for authenticated users under their own directory
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
